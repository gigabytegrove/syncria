# Copy to .env before using Docker Compose.
# Default UI is accessible only on this Docker host.
# For trusted LAN access, set SYNCRIA_BIND_IP to the host's LAN address.
SYNCRIA_BIND_IP=127.0.0.1

# Host directory for Syncria state (Google OAuth tokens, mapping metadata and recovery).
SYNCRIA_DATA_DIR=./data

# Host directory or already-mounted NAS share visible at /sync inside Syncria.
# Example: /mnt/yks-zero1
SYNCRIA_SYNC_DIR=./sync
