# Dashboard binding: loopback when a reverse proxy runs on the host.
SYNCRIA_BIND_IP=127.0.0.1

# Persistent Syncria configuration, credentials, sync indexes and updater.
# This is NOT a directory for synchronized file payloads.
SYNCRIA_DATA_DIR=./data

# NAS devices connect over SMB using their own IP, share and credentials
# configured in the Syncria UI. No NAS bind mounts or SYS_ADMIN required.
