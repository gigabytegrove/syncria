# Web UI binding: 127.0.0.1 for reverse proxy running on host; set LAN IP for local network access.
SYNCRIA_BIND_IP=127.0.0.1

# Persistent configuration, OAuth tokens, sync state, updater and recovery storage.
SYNCRIA_DATA_DIR=./data

# ONE existing host storage root. NAS volumes underneath it are mapped per job in the UI.
# Example host: /mnt/zero1/photos => UI path: /storage/zero1/photos
SYNCRIA_STORAGE_ROOT=/mnt
